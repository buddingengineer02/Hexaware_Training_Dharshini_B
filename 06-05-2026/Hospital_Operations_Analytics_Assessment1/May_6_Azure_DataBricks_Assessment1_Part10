# 89 Create Silver table with cleaned fields
# 90 Add total bill calculation in Silver
# 91 Remove invalid records in Silver
@dlt.table(
    name = "silver_patient_visits_final1"
)

def silver_patient_visits_final1():

    doctors_data = [
        (201,"Cardiology","Hyderabad",1200),
        (202,"Dermatology","Bengaluru",800),
        (203,"Orthopedics","Mumbai",1500),
        (204,"Pediatrics","Delhi",900),
        (205,"Neurology","Hyderabad",2000),
        (206,"Cardiology","Chennai",1300),
        (207,"Dermatology","Kolkata",850),
        (208,"Orthopedics","Bengaluru",1400),
        (209,"Neurology","Kochi",1900),
        (210,"General Medicine","Pune",700)
    ]

    doctors_df = spark.createDataFrame(
        doctors_data,
        [
            "doctor_id",
            "specialization",
            "doctor_city",
            "consultation_fee"
        ]
    )

    return (
        dlt.read("bronze_patient_visits_final1")
        .withColumn(
            "visit_date",
            to_date("visit_date")
        )
        .join(
            doctors_df,
            "doctor_id"
        )
        .withColumn(
            "test_cost",
            col("tests_count") * 500
        )
        .withColumn(
            "total_bill",
            col("consultation_fee") + col("test_cost")
        )
        .filter(
            col("visit_status") != "Cancelled"
        )
    )


# 92 Create Gold table grouped by city
@dlt.table(
    name = "gold_city_revenue_final1"
)

def gold_city_revenue_final1():

    return (
        dlt.read("silver_patient_visits_final1")
        .groupBy("doctor_city")
        .agg(
            _sum("total_bill").alias("total_revenue")
        )
    )


# 93 Create Gold table grouped by specialization
@dlt.table(
    name = "gold_specialization_revenue_final1"
)

def gold_specialization_revenue_final1():

    return (
        dlt.read("silver_patient_visits_final1")
        .groupBy("specialization")
        .agg(
            _sum("total_bill").alias("total_revenue")
        )
    )
